{
  "extends": "../config/tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "plugins": [
      {
        "transform": "@ttsc/lint",
        "configFile": "lint.config.ts"
      }
    ]
  },
  "include": [
    "src",
    "../packages/human/src/executable/NodeCanvasExperiment.ts",
    "../packages/human/src/executable/RunHumanTorsoObservation.ts",
    "../packages/human/src/executable/HumanCurveCost.ts",
    "../packages/motions/src/executable/motionCapture.ts"
  ],
  "exclude": [
    "src/executable"
  ]
}
