{
  "extends": "../config/tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "types": [
      "node"
    ],
    "paths": {
      "#three-addon/*": [
        "../packages/render/node_modules/@types/three/examples/jsm/*",
        "../packages/render/node_modules/three/examples/jsm/*"
      ]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/executable"
  ]
}
