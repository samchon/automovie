{
  "extends": "../config/tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "plugins": [
      {
        "transform": "@ttsc/lint",
        "configFile": "lint.config.ts"
      }
    ]
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/executable"
  ]
}
