{
  "private": true,
  "name": "@automovie/test",
  "version": "0.1.0",
  "description": "automovie test program: exhaustive deterministic engine validation",
  "main": "src/index.ts",
  "scripts": {
    "build": "ttsc --noEmit",
    "start": "ttsx src/index.ts",
    "esbuild:build": "node esbuild.config.mts",
    "esbuild": "pnpm esbuild:build && node bin/index.mjs",
    "evidence": "evidence",
    "conic:build": "esbuild \"src/reference-conics/FamilyConic*.ts\" --bundle --platform=node --format=cjs --external:@napi-rs/canvas --outdir=.shots/esbuild --out-extension:.js=.cjs --log-level=warning",
    "conic:armscye": "pnpm conic:build && node .shots/esbuild/FamilyConicArmscye.cjs",
    "conic:fit": "pnpm conic:build && node .shots/esbuild/FamilyConicBody.cjs",
    "conic:figure": "pnpm conic:build && node .shots/esbuild/FamilyConicFigure.cjs",
    "conic:scan": "pnpm conic:build && node .shots/esbuild/FamilyConicScan.cjs",
    "conic:tree": "pnpm conic:build && node .shots/esbuild/FamilyConicTree.cjs",
    "conic:tip": "pnpm conic:build && node .shots/esbuild/FamilyConicTip.cjs",
    "conic:merge": "pnpm conic:build && node .shots/esbuild/FamilyConicMerge.cjs",
    "conic:ports": "pnpm conic:build && node .shots/esbuild/FamilyConicPorts.cjs"
  },
  "author": "Samchon",
  "license": "MIT",
  "dependencies": {
    "@automovie/archetypes": "workspace:^",
    "@automovie/engine": "workspace:^",
    "@automovie/evidence": "workspace:^",
    "@automovie/human": "workspace:^",
    "@automovie/ingest": "workspace:^",
    "@automovie/interface": "workspace:^",
    "@automovie/motions": "workspace:^",
    "@automovie/recovery": "workspace:^",
    "@automovie/render": "workspace:^",
    "@automovie/template": "workspace:^",
    "@automovie/viewer": "workspace:^",
    "@gltf-transform/core": "catalog:gltf",
    "@gltf-transform/extensions": "catalog:gltf",
    "@huggingface/transformers": "catalog:media",
    "@nestia/e2e": "catalog:samchon",
    "automovie": "workspace:^",
    "h264-mp4-encoder": "catalog:media",
    "kokoro-js": "catalog:media",
    "libopus-wasm": "catalog:media",
    "onnxruntime-node": "catalog:media",
    "pngjs": "catalog:media",
    "three": "catalog:three",
    "tstl": "catalog:samchon",
    "typia": "catalog:samchon"
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@ttsc/evidence": "catalog:samchon",
    "@ttsc/lint": "catalog:samchon",
    "@ttsc/unplugin": "catalog:samchon",
    "@types/jsdom": "^21.1.7",
    "@types/node": "catalog:utils",
    "@napi-rs/canvas": "1.0.1",
    "@types/pngjs": "catalog:media",
    "@types/three": "catalog:three",
    "@wrtnlabs/evidence": "catalog:samchon",
    "chalk": "catalog:utils",
    "devalue": "6.0.2",
    "esbuild": "catalog:vite",
    "jsdom": "26.1.0",
    "mp4box": "catalog:media",
    "playwright": "catalog:media",
    "ttsc": "catalog:samchon",
    "typescript": "catalog:typescript",
    "typescript-compiler": "npm:typescript@5.9.3",
    "vite": "catalog:vite",
    "yaml": "^2.9.0"
  }
}
