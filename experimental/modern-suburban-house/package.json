{
  "name": "modern-suburban-house",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "exports": {
    "./viewer/scene": {
      "default": "./src/viewer/scene.mts"
    }
  },
  "license": "MIT",
  "description": "An AutoMovie coding-agent production repository.",
  "engines": {
    "node": ">=22.23.2"
  },
  "compilerOptions": {
    "target": "esnext",
    "lib": ["ESNext", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "newLine": "lf",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": ".",
    "noEmitOnError": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "plugins": [
      {
        "transform": "@ttsc/lint",
        "configFile": "source.lint.config.ts"
      }
    ],
    "allowJs": true,
    "checkJs": true
  },
  "include": ["lint.config.ts", "src"],
  "scripts": {
    "lint": "ttsc --noEmit -p package.json",
    "format": "ttsc format --cache-dir node_modules/.cache/ttsc -p package.json",
    "viewer": "tsx src/viewer/server.cts",
    "geometry-audit": "tsx src/measurements/geometry-check.ts",
    "test": "node --import tsx --test src/measurements/*.test.cts src/measurements/*.test.ts src/spaces/*.test.cts",
    "docs-review-host": "tsx src/measurements/docs-review-host.cts",
    "check": "tsx src/measurements/check.cts",
    "check:spaces": "tsx src/measurements/check.cts --layer=spaces",
    "regression:1952-repair": "tsx src/measurements/scene-regression.cts",
    "check:models": "tsx src/measurements/check.cts --layer=models",
    "check:settings": "tsx src/measurements/check.cts --layer=settings",
    "evidence": "evidence --config lint.config.ts && pnpm run evidence:guards",
    "evidence:guards": "ttsc --noEmit -p tsconfig.evidence.json"
  },
  "dependencies": {
    "@automovie/archetypes": "workspace:^",
    "automovie": "workspace:^",
    "@automovie/engine": "workspace:^",
    "@automovie/human": "workspace:^",
    "@automovie/ingest": "workspace:^",
    "@automovie/interface": "workspace:^",
    "@automovie/production": "workspace:^",
    "@automovie/render": "workspace:^",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@automovie/evidence": "workspace:^",
    "@automovie/template": "workspace:^",
    "@ttsc/lint": "catalog:samchon",
    "@types/node": "^22.19.17",
    "ttsc": "catalog:samchon",
    "typescript": "^7.0.2",
    "@types/three": "^0.186.0",
    "tsx": "^4.23.15",
    "@wrtnlabs/evidence": "catalog:samchon",
    "@ttsc/evidence": "catalog:samchon"
  }
}
