{
  "name": "medieval-baron-manor",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "license": "MIT",
  "description": "The authored medieval baron manor used by the public website.",
  "engines": {
    "node": ">=22.23.2"
  },
  "compilerOptions": {
    "target": "esnext",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "newLine": "lf",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "rootDir": ".",
    "noEmitOnError": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "plugins": [
      {
        "transform": "@ttsc/lint",
        "configFile": "src/lint.config.ts"
      }
    ],
    "allowJs": true
  },
  "include": [
    "src"
  ],
  "scripts": {
    "lint": "ttsc --cache-dir node_modules/.cache/ttsc --noEmit -p package.json",
    "format": "ttsc format --cache-dir node_modules/.cache/ttsc -p package.json"
  },
  "dependencies": {
    "@automovie/archetypes": "workspace:^",
    "automovie": "workspace:^",
    "@automovie/engine": "workspace:^",
    "@automovie/human": "workspace:^",
    "@automovie/ingest": "workspace:^",
    "@automovie/interface": "workspace:^",
    "@automovie/production": "workspace:^",
    "@automovie/render": "workspace:^",
    "@automovie/viewer": "workspace:^",
    "three": "catalog:three"
  },
  "devDependencies": {
    "@automovie/evidence": "workspace:^",
    "@automovie/template": "workspace:^",
    "@ttsc/lint": "catalog:typescript",
    "@types/node": "catalog:utils",
    "@types/three": "catalog:three",
    "ttsc": "catalog:typescript",
    "typescript": "catalog:typescript"
  }
}
