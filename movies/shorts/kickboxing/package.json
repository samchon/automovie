{
  "name": "kickboxing",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "license": "MIT",
  "description": "An AutoMovie coding-agent production repository.",
  "engines": {
    "node": ">=22.23.2"
  },
  "scripts": {
    "lint": "ttsc --cache-dir node_modules/.cache/ttsc --noEmit -p tsconfig.json",
    "format": "ttsc format --cache-dir node_modules/.cache/ttsc -p tsconfig.json",
    "evidence": "evidence",
    "test": "ttsx --cache-dir node_modules/.cache/ttsc -P tsconfig.test.json test/index.ts",
    "dev": "vite --host 127.0.0.1 --port 5199 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5198 --strictPort",
    "render": "ttsx --cache-dir node_modules/.cache/ttsc -P tsconfig.json src/executable/render.ts",
    "capture": "ttsx --no-plugins --noCheck -P tsconfig.json src/executable/capture.ts",
    "review": "ttsx --cache-dir node_modules/.cache/ttsc -P tsconfig.json src/executable/review.ts",
    "physics": "ttsx --cache-dir node_modules/.cache/ttsc -P tsconfig.json src/executable/physics.ts"
  },
  "dependencies": {
    "@automovie/engine": "workspace:^",
    "@automovie/human": "workspace:^",
    "@automovie/ingest": "workspace:^",
    "@automovie/interface": "workspace:^",
    "@automovie/recovery": "workspace:^",
    "@automovie/render": "workspace:^",
    "@automovie/viewer": "workspace:^",
    "@gltf-transform/core": "catalog:gltf",
    "h264-mp4-encoder": "catalog:media",
    "mp4box": "catalog:media",
    "playwright-core": "catalog:media",
    "pngjs": "catalog:media"
  },
  "devDependencies": {
    "@automovie/evidence": "workspace:^",
    "@nestia/e2e": "catalog:samchon",
    "@ttsc/lint": "^0.36.0",
    "@types/node": "^22.19.17",
    "@types/pngjs": "catalog:media",
    "@types/three": "catalog:three",
    "@wrtnlabs/evidence": "^0.8.2",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "playwright-core": "catalog:media",
    "three": "catalog:three",
    "ttsc": "^0.36.0",
    "typescript": "^7.0.2",
    "vite": "catalog:vite"
  }
}
