{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "three", "vite/client"],
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "plugins": [
      {
        "transform": "@ttsc/lint",
        "configFile": "lint.config.ts"
      }
    ]
  },
  "include": ["src", "scripts/*.ts", "scripts/*.cts"]
}
