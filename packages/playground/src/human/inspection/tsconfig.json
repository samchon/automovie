{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "../../../../..",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [
      "node",
      "vite/client"
    ],
    "plugins": [
      {
        "transform": "@ttsc/lint",
        "configFile": "../../../lint.config.ts"
      }
    ],
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "*.ts"
  ]
}
