{
  "private": true,
  "name": "@automovie/playground",
  "version": "0.1.0",
  "description": "automovie playground, a usable web UI: viewer viewport + humanoid character editor",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "ttsc --noEmit && vite build",
    "build:stickman": "ttsx --no-plugins scripts/build-stickman.ts",
    "build:cat": "ttsx --no-plugins scripts/build-cat.ts",
    "build:horse": "ttsx --no-plugins scripts/build-horse.ts",
    "build:knight": "ttsx --no-plugins scripts/build-knight.ts",
    "build:models": "npm run build:stickman && npm run build:cat && npm run build:horse && npm run build:knight",
    "render:see": "ttsx --no-plugins scripts/render-and-see.ts --",
    "render:sequence": "ttsx --no-plugins scripts/render-sequence-and-see.ts --",
    "shots": "ttsx --no-plugins scripts/capture-shots.ts --",
    "preview": "vite preview --port 4173 --strictPort",
    "smoke:capture": "ttsx --no-plugins scripts/capture-smoke.ts --",
    "evidence": "evidence"
  },
  "author": "Samchon",
  "license": "MIT",
  "dependencies": {
    "@automovie/archetypes": "workspace:^",
    "@automovie/engine": "workspace:^",
    "@automovie/interface": "workspace:^",
    "@automovie/render": "workspace:^",
    "@automovie/viewer": "workspace:^",
    "three": "catalog:three"
  },
  "devDependencies": {
    "@gltf-transform/core": "catalog:gltf",
    "@types/node": "catalog:utils",
    "@types/pngjs": "catalog:media",
    "@types/three": "catalog:three",
    "esbuild": "catalog:vite",
    "gifenc": "catalog:media",
    "h264-mp4-encoder": "catalog:media",
    "playwright-core": "catalog:media",
    "pngjs": "catalog:media",
    "ttsc": "catalog:samchon",
    "typescript": "catalog:typescript",
    "vite": "catalog:vite",
    "@ttsc/lint": "catalog:samchon",
    "@wrtnlabs/evidence": "catalog:samchon",
    "@ttsc/evidence": "catalog:samchon"
  },
  "exports": {
    "./film/ICompilePursuitFilm": "./src/film/ICompilePursuitFilm.ts",
    "./film/compilePursuitFilm": "./src/film/compilePursuitFilm.ts"
  }
}
