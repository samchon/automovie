{
  "name": "@automovie/human",
  "version": "0.1.0",
  "description": "Human figure generated from typed parameters by code",
  "engines": {
    "node": ">=22.23.2"
  },
  "main": "src/index.ts",
  "exports": {
    ".": {
      "browser": "./lib/browser/index.js",
      "default": "./src/index.ts"
    },
    "./control": "./src/control/index.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": { "*": { "control": ["src/control/index.ts"] } },
  "scripts": {
    "build": "ttsc --noEmit && rimraf lib && ttsc && ttsc -p tsconfig.browser.json",
    "prepack": "pnpm run build"
  },
  "keywords": [],
  "author": "Samchon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samchon/automovie"
  },
  "files": [
    "lib",
    "src",
    "package.json",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "typesVersions": { "*": { "control": ["lib/control/index.d.ts"] } },
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "browser": "./lib/browser/index.js",
        "default": "./lib/index.js"
      },
      "./control": {
        "types": "./lib/control/index.d.ts",
        "browser": "./lib/browser/control/index.js",
        "default": "./lib/control/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "devDependencies": {
    "rimraf": "catalog:utils",
    "ttsc": "catalog:samchon",
    "typescript": "catalog:typescript",
    "@ttsc/lint": "catalog:samchon",
    "@ttsc/evidence": "catalog:samchon",
    "@types/node": "catalog:utils"
  },
  "dependencies": {
    "@automovie/engine": "workspace:^",
    "@automovie/interface": "workspace:^",
    "typia": "catalog:samchon"
  }
}
