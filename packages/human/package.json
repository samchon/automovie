{
  "name": "@automovie/human",
  "version": "0.1.0",
  "description": "Human figure generated from typed parameters by code",
  "engines": {
    "node": ">=22.23.2"
  },
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./capture": "./src/capture/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "ttsc --noEmit -P tsconfig.executable.json && rimraf lib && ttsc",
    "capture": "ttsx --no-plugins --noCheck -P tsconfig.executable.json node_modules/automovie/src/bin.ts capture --module src/executable/subjects.ts",
    "inspect": "ttsx --no-plugins --noCheck -P tsconfig.executable.json node_modules/automovie/src/bin.ts inspect --module src/executable/subjects.ts"
  },
  "keywords": [],
  "author": "Samchon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samchon/automovie"
  },
  "files": [
    "lib",
    "src",
    "package.json",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "devDependencies": {
    "@automovie/recovery": "workspace:^",
    "@napi-rs/canvas": "1.0.1",
    "@automovie/render": "workspace:^",
    "@automovie/viewer": "workspace:^",
    "automovie": "workspace:^",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "@types/three": "catalog:three",
    "playwright-core": "catalog:media",
    "three": "catalog:three",
    "vite": "catalog:vite",
    "rimraf": "catalog:utils",
    "tstl": "catalog:samchon",
    "ttsc": "catalog:samchon",
    "typescript": "catalog:typescript",
    "@ttsc/lint": "catalog:samchon",
    "@ttsc/evidence": "catalog:samchon",
    "@types/node": "catalog:utils"
  },
  "dependencies": {
    "@automovie/engine": "workspace:^",
    "@automovie/interface": "workspace:^",
    "typia": "catalog:samchon"
  }
}
