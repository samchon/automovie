{
  "name": "@automovie/human",
  "version": "0.1.0",
  "description": "Deterministic anatomical face construction and replayable editing documents",
  "engines": {
    "node": ">=22.23.2"
  },
  "main": "src/index.ts",
  "exports": {
    ".": {
      "browser": "./lib/browser/index.js",
      "default": "./src/index.ts"
    },
    "./face/*": {
      "browser": "./lib/browser/face/*.js",
      "default": "./src/face/*.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf lib && ttsc && ttsc --module esnext --moduleResolution bundler --outDir lib/browser",
    "prepack": "pnpm run build"
  },
  "keywords": [],
  "author": "Samchon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samchon/automovie"
  },
  "files": [
    "lib",
    "src",
    "package.json",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "browser": "./lib/browser/index.js",
        "default": "./lib/index.js"
      },
      "./face/*": {
        "types": "./lib/face/*.d.ts",
        "browser": "./lib/browser/face/*.js",
        "default": "./lib/face/*.js"
      },
      "./package.json": "./package.json"
    }
  },
  "devDependencies": {
    "rimraf": "catalog:utils",
    "ttsc": "catalog:typescript",
    "typescript": "catalog:typescript",
    "@ttsc/lint": "catalog:typescript"
  },
  "dependencies": {
    "fflate": "catalog:media",
    "@automovie/engine": "workspace:^",
    "@automovie/interface": "workspace:^",
    "typia": "catalog:samchon",
    "@gltf-transform/core": "catalog:gltf",
    "@gltf-transform/extensions": "catalog:gltf"
  }
}
