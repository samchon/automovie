{
  "name": "@automovie/human",
  "version": "0.1.0",
  "description": "Human figure generated from typed parameters by code",
  "engines": {
    "node": ">=22.23.2"
  },
  "main": "src/index.ts",
  "exports": {
    ".": {
      "browser": "./lib/browser/index.js",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "ttsx --no-plugins -P tsconfig.scripts.json scripts/guard.ts && ttsc --noEmit && rimraf lib && ttsc && ttsc -p tsconfig.browser.json",
    "prepack": "pnpm run build"
  },
  "keywords": [],
  "author": "Samchon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samchon/automovie"
  },
  "files": [
    "lib",
    "src",
    "package.json",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "browser": "./lib/browser/index.js",
        "default": "./lib/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "devDependencies": {
    "rimraf": "catalog:utils",
    "ttsc": "catalog:samchon",
    "typescript": "catalog:typescript",
    "@ttsc/lint": "catalog:samchon",
    "@ttsc/evidence": "catalog:samchon",
    "typescript-compiler": "npm:typescript@5.9.3",
    "@types/node": "catalog:utils"
  },
  "dependencies": {
    "@automovie/engine": "workspace:^",
    "@automovie/interface": "workspace:^",
    "typia": "catalog:samchon"
  }
}
