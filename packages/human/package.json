{
  "name": "@automovie/human",
  "version": "0.1.0",
  "description": "Human figure generated from typed parameters by code",
  "engines": {
    "node": ">=22.23.2"
  },
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./control": "./src/control/index.ts",
    "./instance": "./src/instance/index.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": { "*": { "control": ["src/control/index.ts"], "instance": ["src/instance/index.ts"] } },
  "scripts": {
    "debug": "vite",
    "debug:check": "ttsc --noEmit -p tsconfig.debug.json",
    "debug:watch": "ttsc --noEmit --watch -p tsconfig.debug.json",
    "build": "ttsc --noEmit && rimraf lib && ttsc",
    "prepack": "pnpm run build"
  },
  "keywords": [],
  "author": "Samchon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samchon/automovie"
  },
  "files": [
    "lib",
    "src",
    "package.json",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "typesVersions": { "*": { "control": ["lib/control/index.d.ts"], "instance": ["lib/instance/index.d.ts"] } },
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./control": {
        "types": "./lib/control/index.d.ts",
        "default": "./lib/control/index.js"
      },
      "./instance": {
        "types": "./lib/instance/index.d.ts",
        "default": "./lib/instance/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "devDependencies": {
    "@automovie/render": "workspace:^",
    "@automovie/viewer": "workspace:^",
    "@types/three": "catalog:three",
    "playwright-core": "catalog:media",
    "three": "catalog:three",
    "vite": "catalog:vite",
    "rimraf": "catalog:utils",
    "tstl": "catalog:samchon",
    "ttsc": "catalog:samchon",
    "typescript": "catalog:typescript",
    "@ttsc/lint": "catalog:samchon",
    "@ttsc/evidence": "catalog:samchon",
    "@types/node": "catalog:utils"
  },
  "dependencies": {
    "@automovie/engine": "workspace:^",
    "@automovie/interface": "workspace:^",
    "typia": "catalog:samchon"
  }
}
