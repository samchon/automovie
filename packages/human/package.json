{
  "name": "@automovie/human",
  "version": "0.1.0",
  "description": "Human figure generated from typed parameters by code",
  "engines": {
    "node": ">=22.23.2"
  },
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "debug": "vite",
    "debug:check": "ttsc --noEmit -p tsconfig.debug.json",
    "debug:watch": "ttsc --noEmit --watch -p tsconfig.debug.json",
    "node:canvas": "ttsx --no-plugins --noCheck -P tsconfig.json src/executable/NodeCanvasExperiment.ts",
    "node:reference-bases": "ttsx --no-plugins --noCheck -P tsconfig.json src/executable/HumanReferenceBasis.ts",
    "node:reference": "ttsx --no-plugins --noCheck -P tsconfig.json src/executable/HumanReferenceInspect.ts",
    "node:six": "ttsx --no-plugins --noCheck -P tsconfig.json src/executable/NodeCanvasSix.ts",
    "node:inspect": "ttsx --no-plugins --noCheck -P tsconfig.json src/executable/NodeCanvasInspect.ts",
    "node:curve-cost": "ttsx --no-plugins --noCheck -P tsconfig.json src/executable/HumanCurveCost.ts",
    "node:scalar-cost": "ttsx --no-plugins --noCheck -P tsconfig.json src/executable/HumanScalarPreparationCost.ts",
    "node:cpu-summary": "ttsx --no-plugins --noCheck -P tsconfig.json src/executable/HumanCpuProfileSummary.ts",
    "node:profile": "ttsx --no-plugins --noCheck -P tsconfig.json src/executable/HumanProfileCompare.ts",
    "build": "ttsc --noEmit && rimraf lib && ttsc",
    "prepack": "pnpm run build",
    "node:torso": "ttsx --no-plugins --noCheck -P tsconfig.json src/executable/RunHumanTorsoObservation.ts",
    "node:arm-measure": "ttsx --no-plugins --noCheck -P tsconfig.json src/executable/NodeArmMeasure.ts",
    "node:head-measure": "ttsx --no-plugins --noCheck -P tsconfig.json src/executable/NodeHeadMeasure.ts",
    "node:capture": "ttsx --no-plugins --noCheck -P tsconfig.json src/executable/NodeCapture.ts",
    "node:f1-trace": "ttsx --no-plugins --noCheck -P tsconfig.json src/executable/NodeF1TraceReceipt.ts"
  },
  "keywords": [],
  "author": "Samchon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samchon/automovie"
  },
  "files": [
    "lib",
    "src",
    "package.json",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "devDependencies": {
    "@automovie/recovery": "workspace:^",
    "@napi-rs/canvas": "1.0.1",
    "@playwright/mcp": "catalog:media",
    "@automovie/render": "workspace:^",
    "@automovie/viewer": "workspace:^",
    "@types/three": "catalog:three",
    "playwright-core": "catalog:media",
    "three": "catalog:three",
    "vite": "catalog:vite",
    "rimraf": "catalog:utils",
    "tstl": "catalog:samchon",
    "ttsc": "catalog:samchon",
    "typescript": "catalog:typescript",
    "@ttsc/lint": "catalog:samchon",
    "@ttsc/evidence": "catalog:samchon",
    "@types/node": "catalog:utils"
  },
  "dependencies": {
    "@automovie/engine": "workspace:^",
    "@automovie/interface": "workspace:^",
    "typia": "catalog:samchon"
  }
}
