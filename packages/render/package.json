{
  "name": "@automovie/render",
  "version": "0.1.0",
  "description": "automovie render: deterministic frame schedule + encode plan from a render spec",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node/index.ts",
    "./node/chrome": "./src/node/capture/DEFAULT_CHROME_EXECUTABLE.ts",
    "./package.json": "./package.json",
    "./film/equalOrderedScalars": "./src/film/equalOrderedScalars.ts",
    "./node/equalRational": "./src/node/equalRational.ts",
    "./node/exactProductionClockProduct": "./src/node/exactProductionClockProduct.ts"
  },
  "scripts": {
    "build": "rimraf lib && ttsc",
    "prepack": "pnpm run build",
    "evidence": "evidence"
  },
  "author": "Samchon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samchon/automovie"
  },
  "files": [
    "lib",
    "src",
    "package.json",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./node": {
        "types": "./lib/node/index.d.ts",
        "default": "./lib/node/index.js"
      },
      "./node/chrome": {
        "types": "./lib/node/capture/DEFAULT_CHROME_EXECUTABLE.d.ts",
        "default": "./lib/node/capture/DEFAULT_CHROME_EXECUTABLE.js"
      },
      "./package.json": "./package.json",
      "./film/equalOrderedScalars": {
        "types": "./lib/film/equalOrderedScalars.d.ts",
        "default": "./lib/film/equalOrderedScalars.js"
      },
      "./node/equalRational": {
        "types": "./lib/node/equalRational.d.ts",
        "default": "./lib/node/equalRational.js"
      },
      "./node/exactProductionClockProduct": {
        "types": "./lib/node/exactProductionClockProduct.d.ts",
        "default": "./lib/node/exactProductionClockProduct.js"
      }
    }
  },
  "dependencies": {
    "@automovie/engine": "workspace:^",
    "@automovie/ingest": "workspace:^",
    "@automovie/interface": "workspace:^",
    "@gltf-transform/core": "catalog:gltf",
    "mp4box": "catalog:media",
    "pngjs": "catalog:media",
    "@automovie/viewer": "workspace:^",
    "h264-mp4-encoder": "catalog:media",
    "playwright-core": "catalog:media"
  },
  "devDependencies": {
    "@types/pngjs": "catalog:media",
    "rimraf": "catalog:utils",
    "ttsc": "catalog:samchon",
    "typescript": "catalog:typescript",
    "@ttsc/lint": "catalog:samchon",
    "@wrtnlabs/evidence": "catalog:samchon",
    "@ttsc/evidence": "catalog:samchon"
  }
}
