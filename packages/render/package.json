{
  "name": "@automovie/render",
  "version": "0.1.0",
  "description": "automovie render: deterministic frame schedule + encode plan from a render spec",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf lib && ttsc && rolldown -c",
    "evidence": "evidence"
  },
  "author": "Samchon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samchon/automovie"
  },
  "files": [
    "lib",
    "src",
    "package.json",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "types": "lib/index.d.ts",
    "main": "lib/index.js",
    "module": "lib/index.mjs",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "import": "./lib/index.mjs",
        "default": "./lib/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@automovie/engine": "workspace:^",
    "@automovie/ingest": "workspace:^",
    "@automovie/interface": "workspace:^",
    "mp4box": "catalog:media",
    "h264-mp4-encoder": "catalog:media",
    "three": "catalog:three"
  },
  "devDependencies": {
    "@types/node": "catalog:utils",
    "@types/three": "catalog:three",
    "rimraf": "catalog:utils",
    "rolldown": "catalog:rolldown",
    "ttsc": "catalog:samchon",
    "typescript": "catalog:typescript",
    "@ttsc/lint": "catalog:samchon",
    "@wrtnlabs/evidence": "catalog:samchon",
    "@ttsc/evidence": "catalog:samchon"
  },
  "engines": {
    "node": ">=22.23.2"
  }
}
