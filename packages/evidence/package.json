{
  "name": "@automovie/evidence",
  "version": "0.1.0",
  "description": "Production-kind-aware AutoMovie evidence graph construction and validation.",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf lib && ttsc",
    "prepack": "pnpm run build",
    "evidence": "evidence && pnpm run evidence:guards",
    "evidence:guards": "ttsc --noEmit -p tsconfig.evidence.json"
  },
  "keywords": [
    "automovie",
    "evidence",
    "traceability"
  ],
  "author": "Samchon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samchon/automovie"
  },
  "files": [
    "lib",
    "src",
    "package.json",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@ttsc/evidence": "catalog:samchon",
    "typescript-compiler": "npm:typescript@5.9.3",
    "@wrtnlabs/evidence": "catalog:samchon"
  },
  "devDependencies": {
    "@ttsc/lint": "catalog:samchon",
    "@types/node": "catalog:utils",
    "rimraf": "catalog:utils",
    "ttsc": "catalog:samchon"
  }
}
