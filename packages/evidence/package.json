{
  "name": "@automovie/evidence",
  "version": "0.1.0",
  "description": "Evidence configuration and optional narrative lifecycle validation for AutoMovie productions",
  "engines": {
    "node": ">=22.23.2"
  },
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./narrative": "./src/narrative/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf lib && ttsc",
    "prepack": "pnpm run build",
    "evidence": "evidence"
  },
  "keywords": [
    "automovie",
    "evidence"
  ],
  "author": "Samchon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samchon/automovie"
  },
  "files": [
    "lib",
    "src",
    "package.json",
    "LICENSE",
    "LICENSE.novels",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./narrative": {
        "types": "./lib/narrative/index.d.ts",
        "default": "./lib/narrative/index.js"
      },
      "./package.json": "./package.json"
    },
    "typesVersions": {
      "*": {
        "narrative": [
          "lib/narrative/index.d.ts"
        ]
      }
    }
  },
  "typesVersions": {
    "*": {
      "narrative": [
        "src/narrative/index.ts"
      ]
    }
  },
  "dependencies": {
    "@wrtnlabs/evidence": "catalog:samchon"
  },
  "devDependencies": {
    "@ttsc/evidence": "catalog:samchon",
    "@ttsc/lint": "catalog:samchon",
    "@types/node": "catalog:utils",
    "rimraf": "catalog:utils",
    "ttsc": "catalog:samchon",
    "typescript": "catalog:typescript"
  }
}
