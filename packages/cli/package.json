{
  "name": "automovie",
  "version": "0.4.2",
  "description": "Scaffold a coding-agent-first AutoMovie production repository.",
  "main": "src/index.ts",
  "bin": {
    "automovie": "lib/bin.js"
  },
  "scripts": {
    "build": "rimraf lib && ttsc && node -e \"require('node:fs').copyFileSync('../../README.md', 'README.md')\"",
    "prepack": "node ../../scripts/copy-package-notices.mjs",
    "start": "ttsx src/bin.ts",
    "evidence": "evidence"
  },
  "keywords": [
    "automovie",
    "cli",
    "sdk",
    "scaffold",
    "starter",
    "create"
  ],
  "author": "Samchon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samchon/automovie"
  },
  "files": [
    "lib",
    "src",
    "package.json",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.23.2"
  },
  "imports": {
    "#production-check-entry": "./src/production/internal/importProductionCheckEntry.mts"
  },
  "publishConfig": {
    "access": "public",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "bin": {
      "automovie": "lib/bin.js"
    },
    "imports": {
      "#production-check-entry": "./lib/production/internal/importProductionCheckEntry.mjs"
    },
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@automovie/engine": "workspace:^",
    "@automovie/interface": "workspace:^",
    "@automovie/template": "workspace:^"
  },
  "peerDependencies": {
    "@automovie/render": "workspace:^",
    "ffmpeg-static": "catalog:media",
    "playwright-core": "catalog:media",
    "vite": "catalog:vite"
  },
  "peerDependenciesMeta": {
    "@automovie/render": {
      "optional": true
    },
    "ffmpeg-static": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@automovie/config": "workspace:^",
    "@automovie/render": "workspace:^",
    "@ttsc/evidence": "catalog:samchon",
    "@types/node": "catalog:utils",
    "rimraf": "catalog:utils",
    "ttsc": "catalog:samchon",
    "typescript": "catalog:typescript",
    "@ttsc/lint": "catalog:samchon",
    "@wrtnlabs/evidence": "catalog:samchon"
  }
}
