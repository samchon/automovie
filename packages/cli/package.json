{
  "name": "automovie",
  "version": "0.1.0",
  "description": "Scaffold a coding-agent-first AutoMovie production repository.",
  "main": "src/index.ts",
  "bin": {
    "automovie": "lib/bin.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf lib && ttsc && node -e \"require('node:fs').copyFileSync('../../README.md', 'README.md')\"",
    "start": "ttsx src/bin.ts",
    "evidence": "evidence"
  },
  "keywords": [
    "automovie",
    "cli",
    "sdk",
    "scaffold",
    "starter",
    "create"
  ],
  "author": "Samchon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samchon/automovie"
  },
  "files": [
    "lib",
    "src",
    "package.json",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "bin": {
      "automovie": "lib/bin.js"
    },
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@automovie/template": "workspace:^"
  },
  "peerDependencies": {
    "@automovie/render": "workspace:^",
    "ffmpeg-static": "catalog:media",
    "playwright-core": "catalog:media",
    "vite": "catalog:vite"
  },
  "peerDependenciesMeta": {
    "@automovie/render": {
      "optional": true
    },
    "ffmpeg-static": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@automovie/render": "workspace:^",
    "@ttsc/evidence": "catalog:samchon",
    "@types/node": "catalog:utils",
    "rimraf": "catalog:utils",
    "ttsc": "catalog:samchon",
    "typescript": "catalog:typescript",
    "@ttsc/lint": "catalog:samchon",
    "@wrtnlabs/evidence": "catalog:samchon"
  }
}
