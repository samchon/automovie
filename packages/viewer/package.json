{
  "name": "@automovie/viewer",
  "version": "0.1.0",
  "description": "automovie viewer: three.js renderer that plays automovie models, poses, and motion (not an editor)",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node/index.ts",
    "./human": "./src/human/index.ts",
    "./package.json": "./package.json",
    "./process/ProcessOwnership": "./src/process/ProcessOwnership.ts",
    "./inspection/createViewerDiskSource": "./src/inspection/createViewerDiskSource.ts",
    "./inspection/readViewerMaintainedSourceFiles": "./src/inspection/readViewerMaintainedSourceFiles.ts",
    "./AutoMovieResourceRetirementScope": "./src/AutoMovieResourceRetirementScope.ts",
    "./IViewerCameraStateSnapshot": "./src/IViewerCameraStateSnapshot.ts",
    "./constructAutoMovieOwnedResources": "./src/constructAutoMovieOwnedResources.ts",
    "./createViewerDisplayClock": "./src/createViewerDisplayClock.ts",
    "./createViewerDisplayPublication": "./src/createViewerDisplayPublication.ts",
    "./process/internal/IProcessOwnershipHost": "./src/process/internal/IProcessOwnershipHost.ts",
    "./process/internal/ProcessOwnershipController": "./src/process/internal/ProcessOwnershipController.ts",
    "./process/internal/decodeWindowsProcessResult": "./src/process/internal/decodeWindowsProcessResult.ts",
    "./process/internal/decodePosixProcessIdentity": "./src/process/internal/decodePosixProcessIdentity.ts",
    "./process/internal/decodeLinuxProcessIdentity": "./src/process/internal/decodeLinuxProcessIdentity.ts",
    "./process/internal/resolveProcessIdentityReadError": "./src/process/internal/resolveProcessIdentityReadError.ts"
  },
  "files": [
    "lib",
    "src",
    "package.json",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "typesVersions": { "*": { "human": ["lib/human/index.d.ts"] } },
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./node": {
        "types": "./lib/node/index.d.ts",
        "default": "./lib/node/index.js"
      },
      "./human": {
        "types": "./lib/human/index.d.ts",
        "default": "./lib/human/index.js"
      },
      "./package.json": "./package.json",
      "./process/ProcessOwnership": {
        "types": "./lib/process/ProcessOwnership.d.ts",
        "default": "./lib/process/ProcessOwnership.js"
      },
      "./inspection/createViewerDiskSource": {
        "types": "./lib/inspection/createViewerDiskSource.d.ts",
        "default": "./lib/inspection/createViewerDiskSource.js"
      },
      "./inspection/readViewerMaintainedSourceFiles": {
        "types": "./lib/inspection/readViewerMaintainedSourceFiles.d.ts",
        "default": "./lib/inspection/readViewerMaintainedSourceFiles.js"
      },
      "./AutoMovieResourceRetirementScope": {
        "types": "./lib/AutoMovieResourceRetirementScope.d.ts",
        "default": "./lib/AutoMovieResourceRetirementScope.js"
      },
      "./IViewerCameraStateSnapshot": {
        "types": "./lib/IViewerCameraStateSnapshot.d.ts",
        "default": "./lib/IViewerCameraStateSnapshot.js"
      },
      "./constructAutoMovieOwnedResources": {
        "types": "./lib/constructAutoMovieOwnedResources.d.ts",
        "default": "./lib/constructAutoMovieOwnedResources.js"
      },
      "./createViewerDisplayClock": {
        "types": "./lib/createViewerDisplayClock.d.ts",
        "default": "./lib/createViewerDisplayClock.js"
      },
      "./createViewerDisplayPublication": {
        "types": "./lib/createViewerDisplayPublication.d.ts",
        "default": "./lib/createViewerDisplayPublication.js"
      },
      "./process/internal/IProcessOwnershipHost": {
        "types": "./lib/process/internal/IProcessOwnershipHost.d.ts",
        "default": "./lib/process/internal/IProcessOwnershipHost.js"
      },
      "./process/internal/ProcessOwnershipController": {
        "types": "./lib/process/internal/ProcessOwnershipController.d.ts",
        "default": "./lib/process/internal/ProcessOwnershipController.js"
      },
      "./process/internal/decodeWindowsProcessResult": {
        "types": "./lib/process/internal/decodeWindowsProcessResult.d.ts",
        "default": "./lib/process/internal/decodeWindowsProcessResult.js"
      },
      "./process/internal/decodePosixProcessIdentity": {
        "types": "./lib/process/internal/decodePosixProcessIdentity.d.ts",
        "default": "./lib/process/internal/decodePosixProcessIdentity.js"
      },
      "./process/internal/decodeLinuxProcessIdentity": {
        "types": "./lib/process/internal/decodeLinuxProcessIdentity.d.ts",
        "default": "./lib/process/internal/decodeLinuxProcessIdentity.js"
      },
      "./process/internal/resolveProcessIdentityReadError": {
        "types": "./lib/process/internal/resolveProcessIdentityReadError.d.ts",
        "default": "./lib/process/internal/resolveProcessIdentityReadError.js"
      }
    }
  },
  "typesVersions": { "*": { "human": ["src/human/index.ts"] } },
  "scripts": {
    "build": "rimraf lib && ttsc",
    "prepack": "pnpm run build",
    "evidence": "evidence"
  },
  "keywords": [],
  "author": "Samchon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samchon/automovie"
  },
  "dependencies": {
    "@automovie/engine": "workspace:^",
    "@automovie/human": "workspace:^",
    "@automovie/interface": "workspace:^",
    "three": "catalog:three"
  },
  "devDependencies": {
    "@types/three": "catalog:three",
    "rimraf": "catalog:utils",
    "ttsc": "catalog:samchon",
    "typescript": "catalog:typescript",
    "@ttsc/lint": "catalog:samchon",
    "@wrtnlabs/evidence": "catalog:samchon",
    "@ttsc/evidence": "catalog:samchon",
    "@types/node": "catalog:utils"
  },
  "type": "module",
  "engines": {
    "node": ">=22.23.2"
  }
}
