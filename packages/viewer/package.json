{
  "name": "@automovie/viewer",
  "version": "0.1.0",
  "description": "automovie viewer: the interactive display, a React inspector and an imperative mount over the render package's three.js scene (not an editor)",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "package.json",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "types": "lib/index.d.ts",
    "main": "lib/index.js",
    "module": "lib/index.mjs",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "import": "./lib/index.mjs",
        "default": "./lib/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "rimraf lib && ttsc && rolldown -c",
    "evidence": "evidence"
  },
  "keywords": [],
  "author": "Samchon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samchon/automovie"
  },
  "dependencies": {
    "@automovie/render": "workspace:^",
    "three": "catalog:three"
  },
  "peerDependencies": {
    "react": "catalog:react",
    "react-dom": "catalog:react"
  },
  "devDependencies": {
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "@types/three": "catalog:three",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "rimraf": "catalog:utils",
    "rolldown": "catalog:rolldown",
    "ttsc": "catalog:samchon",
    "typescript": "catalog:typescript",
    "@ttsc/lint": "catalog:samchon",
    "@wrtnlabs/evidence": "catalog:samchon",
    "@ttsc/evidence": "catalog:samchon",
    "@types/node": "catalog:utils"
  },
  "engines": {
    "node": ">=22.23.2"
  }
}
