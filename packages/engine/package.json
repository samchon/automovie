{
  "name": "@automovie/engine",
  "version": "0.1.0",
  "description": "automovie deterministic engine, kinematics, ROM validation, motion sampling, tessellation",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf lib && ttsc",
    "evidence": "evidence"
  },
  "keywords": [],
  "author": "Samchon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samchon/automovie"
  },
  "files": [
    "lib",
    "src",
    "vendor/clarabel",
    "vendor/quadratic",
    "package.json",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@automovie/interface": "workspace:^",
    "@dimforge/rapier3d-compat": "0.21.0"
  },
  "devDependencies": {
    "@ttsc/evidence": "catalog:samchon",
    "@ttsc/lint": "catalog:samchon",
    "@wrtnlabs/evidence": "catalog:samchon",
    "rimraf": "catalog:utils",
    "ttsc": "catalog:samchon",
    "typescript": "catalog:typescript"
  }
}
