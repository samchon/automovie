{
  "name": "@automovie/template",
  "version": "0.1.0",
  "description": "The scaffold every AutoMovie production is created from and the function that creates its files.",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "ttsx --no-plugins build/prepare.ts",
    "build": "rimraf lib && pnpm run prepare && ttsc",    "evidence": "evidence"
  },
  "keywords": [
    "automovie",
    "scaffold",
    "template"
  ],
  "author": "Samchon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samchon/automovie"
  },
  "files": [
    "generated",
    "lib",
    "README.md",
    "scaffold",
    "scaffold/production/_gitignore",
    "scaffold/workspace/_gitignore",
    "src",
    "package.json",
    "LICENSE",
    "!**/node_modules/**",
    "!**/.cache/**",
    "!**/.git/**"
  ],
  "publishConfig": {
    "access": "public",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@automovie/evidence": "workspace:^",
    "@ttsc/evidence": "catalog:samchon",
    "@ttsc/lint": "catalog:samchon",
    "@types/node": "catalog:utils",
    "rimraf": "catalog:utils",
    "ttsc": "catalog:samchon",
    "typescript": "catalog:typescript",
    "@wrtnlabs/evidence": "catalog:samchon"
  }
}
