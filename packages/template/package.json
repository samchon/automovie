{
  "name": "@automovie/template",
  "version": "0.1.5",
  "description": "The self-contained scaffold every AutoMovie production is created from and the library that materializes it.",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./IScaffoldPosixConstants": "./src/IScaffoldPosixConstants.ts",
    "./resolveScaffoldPosixConstants": "./src/resolveScaffoldPosixConstants.ts"
  },
  "scripts": {
    "prepare": "pnpm run build:versions && pnpm run build:instructions",
    "build:versions": "ttsx --no-plugins build/resolveTemplateVersions.ts",
    "build:instructions": "ttsx --no-plugins build/syncScaffoldInstructions.ts",
    "build": "pnpm run build:versions && pnpm run build:instructions && rimraf lib && ttsc",
    "prepack": "pnpm run build",
    "evidence": "evidence"
  },
  "keywords": [
    "automovie",
    "scaffold",
    "template"
  ],
  "author": "Samchon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samchon/automovie"
  },
  "files": [
    "build",
    "lib",
    "README.md",
    "scaffold",
    "scaffold/_gitignore",
    "src",
    "package.json",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./package.json": "./package.json",
      "./IScaffoldPosixConstants": {
        "types": "./lib/IScaffoldPosixConstants.d.ts",
        "default": "./lib/IScaffoldPosixConstants.js"
      },
      "./resolveScaffoldPosixConstants": {
        "types": "./lib/resolveScaffoldPosixConstants.d.ts",
        "default": "./lib/resolveScaffoldPosixConstants.js"
      }
    }
  },
  "dependencies": {
    "koffi": "^3.2.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@automovie/evidence": "workspace:^",
    "@ttsc/evidence": "catalog:samchon",
    "@ttsc/lint": "catalog:samchon",
    "@types/node": "catalog:utils",
    "rimraf": "catalog:utils",
    "ttsc": "catalog:samchon",
    "typescript": "catalog:typescript",
    "@wrtnlabs/evidence": "catalog:samchon"
  }
}
