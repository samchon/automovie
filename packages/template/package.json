{
  "name": "@automovie/template",
  "version": "0.1.5",
  "description": "The self-contained scaffold every AutoMovie production is created from and the library that materializes it.",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "pnpm run build:versions",
    "build:versions": "ttsx --no-plugins build/resolveTemplateVersions.ts",
    "build": "pnpm run build:versions && rimraf lib && ttsc",
    "prepack": "pnpm run build",
    "evidence": "evidence && pnpm run evidence:guards",
    "evidence:guards": "ttsc --noEmit -p tsconfig.evidence.json"
  },
  "keywords": [
    "automovie",
    "scaffold",
    "template"
  ],
  "author": "Samchon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samchon/automovie"
  },
  "files": [
    "build",
    "lib",
    "README.md",
    "language-contracts",
    "scaffold",
    "scaffold/_gitignore",
    "src",
    "package.json",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@automovie/evidence": "workspace:^",
    "@automovie/ingest": "workspace:^",
    "koffi": "^3.2.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@automovie/archetypes": "workspace:^",
    "@automovie/engine": "workspace:^",
    "@automovie/human": "workspace:^",
    "@automovie/interface": "workspace:^",
    "@automovie/mcp": "workspace:^",
    "@automovie/production": "workspace:^",
    "@automovie/render": "workspace:^",
    "@automovie/viewer": "workspace:^",
    "@huggingface/transformers": "catalog:media",
    "@ttsc/evidence": "catalog:samchon",
    "@ttsc/lint": "catalog:samchon",
    "@types/node": "catalog:utils",
    "@types/pngjs": "catalog:media",
    "@types/three": "catalog:three",
    "automovie": "workspace:^",
    "h264-mp4-encoder": "catalog:media",
    "mp4box": "catalog:media",
    "playwright": "catalog:media",
    "pngjs": "catalog:media",
    "rimraf": "catalog:utils",
    "three": "catalog:three",
    "ttsc": "catalog:samchon",
    "typescript": "catalog:typescript",
    "vite": "catalog:vite",
    "@wrtnlabs/evidence": "catalog:samchon"
  }
}
