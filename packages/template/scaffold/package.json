{
  "name": "{{name}}",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "license": "MIT",
  "description": "An AutoMovie coding-agent production repository.",
  "engines": {
    "node": ">=22.23.2"
  },
  "compilerOptions": {
    "target": "esnext",
    "lib": [
      "ESNext"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "newLine": "lf",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "rootDir": ".",
    "noEmitOnError": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "plugins": [
      {
        "transform": "@ttsc/lint",
        "configFile": "lint.config.ts"
      }
    ]
  },
  "include": [
    "lint.config.ts",
    "evidence.config.ts",
    "narrative.config.ts",
    "workflow",
    "src",
    "test"
  ],
  "scripts": {
    "lint": "ttsc --cache-dir node_modules/.cache/ttsc --noEmit -p package.json",
    "format": "ttsc format --cache-dir node_modules/.cache/ttsc -p package.json",
    "evidence": "evidence",
    "production:check": "ttsx --cache-dir node_modules/.cache/ttsc -P package.json workflow/check.ts",
    "test": "ttsx --cache-dir node_modules/.cache/ttsc -P package.json test/index.ts"
  },
  "dependencies": {
    "@automovie/archetypes": "{{version:archetypes}}",
    "@automovie/engine": "{{version:engine}}",
    "@automovie/human": "{{version:human}}",
    "@automovie/ingest": "{{version:ingest}}",
    "@automovie/interface": "{{version:interface}}",
    "@automovie/recovery": "{{version:recovery}}",
    "@automovie/render": "{{version:render}}"
  },
  "devDependencies": {
    "@ttsc/lint": "{{version:ttscLint}}",
    "@types/node": "{{version:nodeTypes}}",
    "ttsc": "{{version:ttsc}}",
    "typescript": "{{version:typescript}}",
    "@wrtnlabs/evidence": "{{version:evidenceCli}}"
  }
}
