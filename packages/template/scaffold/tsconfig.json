{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "newLine": "lf",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"],
    "rootDir": ".",
    "noEmitOnError": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "plugins": [
      {
        "transform": "@ttsc/lint",
        "configFile": "lint.config.ts"
      }
    ]
  },
  "include": [
    "lint.config.ts",
    "evidence.config.ts",
    "vite.config.ts",
    "src",
    "test"
  ]
}
