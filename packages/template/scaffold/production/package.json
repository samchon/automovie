{
  "name": "{{name}}",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "license": "MIT",
  "description": "An AutoMovie coding-agent production repository.",
  "engines": {
    "node": ">=22.23.2"
  },
  "scripts": {
    "lint": "ttsc --cache-dir node_modules/.cache/ttsc --noEmit -p tsconfig.json",
    "format": "ttsc format --cache-dir node_modules/.cache/ttsc -p tsconfig.json",
    "evidence": "evidence",
    "test": "ttsx --cache-dir node_modules/.cache/ttsc -P tsconfig.test.json test/index.ts",
    "dev": "vite",
    "build": "vite build",
    "render": "ttsx --cache-dir node_modules/.cache/ttsc -P tsconfig.json src/executable/render.ts",
    "capture": "automovie capture --module src/subjects.ts",
    "review": "ttsx --cache-dir node_modules/.cache/ttsc -P tsconfig.json src/executable/review.ts",
    "review:setup": "playwright install ffmpeg chromium-headless-shell",
    "physics": "ttsx --cache-dir node_modules/.cache/ttsc -P tsconfig.json src/executable/physics.ts"
  },
  "dependencies": {
    "@automovie/engine": "{{version:engine}}",
    "@automovie/human": "{{version:human}}",
    "@automovie/ingest": "{{version:ingest}}",
    "@automovie/interface": "{{version:interface}}",
    "@automovie/motions": "{{version:motions}}",
    "@automovie/recovery": "{{version:recovery}}",
    "@automovie/render": "{{version:render}}",
    "@automovie/viewer": "{{version:viewer}}",
    "three": "{{version:three}}",
    "react": "{{version:react}}",
    "react-dom": "{{version:reactDom}}",
    "@gltf-transform/core": "{{version:gltfTransformCore}}",
    "h264-mp4-encoder": "{{version:h264Mp4Encoder}}",
    "mp4box": "{{version:mp4box}}",
    "playwright-core": "{{version:playwrightCore}}",
    "pngjs": "{{version:pngjs}}"
  },
  "devDependencies": {
    "automovie": "{{version:cli}}",
    "playwright": "{{version:playwright}}",
    "@nestia/e2e": "{{version:nestiaE2e}}",
    "@automovie/evidence": "{{version:evidence}}",
    "@ttsc/lint": "{{version:ttscLint}}",
    "@types/node": "{{version:nodeTypes}}",
    "ttsc": "{{version:ttsc}}",
    "typescript": "{{version:typescript}}",
    "@wrtnlabs/evidence": "{{version:evidenceCli}}",
    "@types/three": "{{version:threeTypes}}",
    "@types/react": "{{version:reactTypes}}",
    "vite": "{{version:vite}}",
    "ffmpeg-static": "{{version:ffmpegStatic}}",
    "@types/pngjs": "{{version:pngjsTypes}}"
  }
}
