{
  "name": "@automovie/archetypes",
  "version": "0.1.0",
  "description": "Coarse parametric archetypes of the things people hold, use, sit on, ride and fight with, as typed seeded producers of models with affordances",
  "engines": {
    "node": ">=22.23.2"
  },
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./props": "./src/props/index.ts",
    "./furniture": "./src/furniture/index.ts",
    "./architecture": "./src/architecture/index.ts",
    "./vehicles": "./src/vehicles/index.ts",
    "./animals": "./src/animals/index.ts",
    "./weapons": "./src/weapons/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf lib && ttsc",
    "evidence": "evidence",
    "capture": "ttsx --no-plugins --noCheck node_modules/automovie/src/bin.ts capture --module src/executable/subjects.ts",
    "inspect": "ttsx --no-plugins --noCheck node_modules/automovie/src/bin.ts inspect --module src/executable/subjects.ts"
  },
  "keywords": [],
  "author": "Samchon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samchon/automovie"
  },
  "files": [
    "lib",
    "src",
    "!lib/executable",
    "!src/executable",
    "package.json",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./props": {
        "types": "./lib/props/index.d.ts",
        "default": "./lib/props/index.js"
      },
      "./furniture": {
        "types": "./lib/furniture/index.d.ts",
        "default": "./lib/furniture/index.js"
      },
      "./architecture": {
        "types": "./lib/architecture/index.d.ts",
        "default": "./lib/architecture/index.js"
      },
      "./vehicles": {
        "types": "./lib/vehicles/index.d.ts",
        "default": "./lib/vehicles/index.js"
      },
      "./animals": {
        "types": "./lib/animals/index.d.ts",
        "default": "./lib/animals/index.js"
      },
      "./weapons": {
        "types": "./lib/weapons/index.d.ts",
        "default": "./lib/weapons/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@automovie/engine": "workspace:^",
    "@automovie/interface": "workspace:^"
  },
  "devDependencies": {
    "@automovie/render": "workspace:^",
    "@automovie/viewer": "workspace:^",
    "@ttsc/evidence": "catalog:samchon",
    "@ttsc/lint": "catalog:samchon",
    "@types/node": "catalog:utils",
    "@types/three": "catalog:three",
    "@wrtnlabs/evidence": "catalog:samchon",
    "automovie": "workspace:^",
    "playwright-core": "catalog:media",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "rimraf": "catalog:utils",
    "three": "catalog:three",
    "ttsc": "catalog:samchon",
    "typescript": "catalog:typescript",
    "vite": "catalog:vite"
  }
}
