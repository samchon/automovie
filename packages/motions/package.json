{
  "name": "@automovie/motions",
  "version": "0.4.2",
  "description": "automovie human motion vocabulary: body-scaled, seeded and interruptible action laws an LLM author drives through a fluent chain",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./internal": "./src/internal.ts",
    "./executable/internal": "./src/executable/internal.ts",
    "./testing/spacecraftGlideClock": "./src/testing/spacecraftGlideClock.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "!lib/executable",
    "!src/executable",
    "!lib/testing",
    "!src/testing",
    "package.json",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./internal": {
        "types": "./lib/internal.d.ts",
        "default": "./lib/internal.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "rimraf lib && ttsc",
    "evidence": "evidence",
    "node:capture": "ttsx --no-plugins --noCheck src/executable/motionCapture.ts",
    "node:props": "ttsx --no-plugins --noCheck src/executable/motionProps.ts",
    "node:resolve": "ttsx --no-plugins --noCheck src/executable/motionResolve.ts"
  },
  "keywords": [],
  "author": "Samchon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samchon/automovie"
  },
  "engines": {
    "node": ">=22.23.2"
  },
  "dependencies": {
    "@automovie/engine": "workspace:^",
    "@automovie/interface": "workspace:^"
  },
  "devDependencies": {
    "@automovie/config": "workspace:^",
    "@automovie/human": "workspace:^",
    "@automovie/render": "workspace:^",
    "@automovie/viewer": "workspace:^",
    "@ttsc/evidence": "catalog:samchon",
    "automovie": "workspace:^",
    "playwright-core": "catalog:media",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "typia": "catalog:samchon",
    "vite": "catalog:vite",
    "@ttsc/lint": "catalog:samchon",
    "@types/node": "catalog:utils",
    "@types/three": "catalog:three",
    "@wrtnlabs/evidence": "catalog:samchon",
    "rimraf": "catalog:utils",
    "three": "catalog:three",
    "ttsc": "catalog:samchon",
    "typescript": "catalog:typescript"
  }
}
