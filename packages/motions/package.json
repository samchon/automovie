{
  "name": "@automovie/motions",
  "version": "0.1.0",
  "description": "automovie human motion vocabulary: body-scaled, seeded and interruptible action laws an LLM author drives through a fluent chain",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "package.json",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "rimraf lib && ttsc",
    "prepack": "pnpm run build",
    "node:capture": "ttsx --no-plugins --noCheck -P tsconfig.executable.json src/executable/motionCapture.ts"
  },
  "keywords": [],
  "author": "Samchon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samchon/automovie"
  },
  "engines": {
    "node": ">=22.23.2"
  },
  "dependencies": {
    "@automovie/engine": "workspace:^",
    "@automovie/interface": "workspace:^"
  },
  "devDependencies": {
    "@automovie/human": "workspace:^",
    "@automovie/viewer": "workspace:^",
    "@ttsc/evidence": "catalog:samchon",
    "@ttsc/lint": "catalog:samchon",
    "@types/node": "catalog:utils",
    "@types/three": "catalog:three",
    "@wrtnlabs/evidence": "catalog:samchon",
    "rimraf": "catalog:utils",
    "three": "catalog:three",
    "ttsc": "catalog:samchon",
    "typescript": "catalog:typescript"
  }
}
