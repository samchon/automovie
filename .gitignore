.claude/*
!.claude/settings.json
.discussions/
.models/
.wiki/
.references/

node_modules/
packages/cli/.cache/
packages/template/.cache/
lib/
dist/

.DS_Store
*.tsbuildinfo
.env
.env.*
# fetched or generated model assets
packages/playground/public/models/*

# local screenshot scratch (not committed)
.shots/

# Website-only derived transports; rebuilt from production source before use.
website/public/buildings/

# transpiled output that lands beside a source rather than in `lib/`
packages/*/src/**/*.js
packages/*/src/**/*.js.map
# declarations emitted beside a source are compiler output, just like JavaScript.
packages/*/src/**/*.d.ts
# repository instructions the scaffold mirrors; packages/template/build/syncScaffoldInstructions.ts
# regenerates them on prepare and build, and its SHARED list must match these paths
packages/template/scaffold/.agents/skills/development/repair.md
packages/template/scaffold/.agents/skills/documentation/writing.md
# the scaffold nests a whole project, so its own sources need the same rule
packages/template/scaffold/src/**/*.js
packages/template/scaffold/src/**/*.js.map
packages/template/scaffold/src/**/*.d.ts
# the suite is run straight through `ttsx`, so anything emitted beside a case is
# transpiler spill rather than a source file.
test/src/**/*.js
test/src/**/*.js.map
test/src/**/*.d.ts

# Python bytecode
__pycache__/

# Local reference experiment runner and captured artifacts.
test/src/executable/
test/.shots/

# Local registered inputs and retained acquisition/render evidence.
/test/reference-inputs/
/test/.human-audit-reports/
/test/.human-native-captures/
/test/.human-parameter-captures/
/test/.native-build-evidence/
/test/.reference-provenance-quarantine/
/test/.reference-static-20261022-0435/
