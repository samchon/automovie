{
  "private": true,
  "name": "@automovie/station",
  "version": "0.1.0",
  "description": "Coding-agent-native deterministic filmmaking: tracked authoring, compilation, rendering, review, and delivery.",
  "packageManager": "pnpm@10.6.4",
  "scripts": {
    "build": "pnpm --filter=./packages/** -r build",
    "test": "pnpm --filter @automovie/test start",
    "format": "prettier --write \"**/*.{ts,cts,mts}\"",
    "format:check": "prettier --check \"**/*.{ts,cts,mts}\"",
    "evidence": "pnpm --filter=./packages/** --filter=./test --no-bail --no-sort -r evidence",
    "package:latest": "pnpm --filter=./packages/* -r publish --tag latest --access public",
    "package:next": "pnpm --filter=./packages/* -r publish --tag next --access public",
    "package:rc": "pnpm --filter=./packages/* -r publish --tag rc --access public",
    "release": "bumpp -r"
  },
  "keywords": [
    "coding-agent",
    "deterministic",
    "filmmaking",
    "animation",
    "rendering"
  ],
  "author": "Samchon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samchon/automovie"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "catalog:typescript",
    "@ttsc/evidence": "catalog:samchon",
    "@ttsc/lint": "catalog:samchon",
    "@types/node": "catalog:utils",
    "@wrtnlabs/evidence": "catalog:samchon",
    "bumpp": "catalog:utils",
    "prettier": "catalog:typescript",
    "rimraf": "catalog:utils",
    "ttsc": "catalog:samchon",
    "typescript": "catalog:typescript",
    "typescript-compiler": "npm:typescript@5.9.3"
  }
}
