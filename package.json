{
  "private": true,
  "name": "@automovie/station",
  "version": "0.1.0",
  "description": "Coding-agent-native deterministic filmmaking: tracked authoring, compilation, rendering, review, and delivery.",
  "packageManager": "pnpm@10.6.4",
  "scripts": {
    "automovie": "ttsx --no-plugins -P packages/cli/tsconfig.json packages/cli/src/bin.ts",
    "build": "pnpm --filter=./packages/** -r build",
    "test": "pnpm --filter @automovie/test start",
    "format": "prettier --write \"**/*.{ts,cts,mts}\"",
    "format:check": "prettier --check \"**/*.{ts,cts,mts}\"",
    "evidence": "pnpm --filter=./packages/** --filter=./test --no-bail --no-sort -r evidence",
    "package:latest": "pnpm run build && pnpm --filter=./packages/* -r publish --tag latest --access public",
    "package:next": "pnpm run build && pnpm --filter=./packages/* -r publish --tag next --access public",
    "package:rc": "pnpm run build && pnpm --filter=./packages/* -r publish --tag rc --access public",
    "release": "bumpp -r"
  },
  "keywords": [
    "coding-agent",
    "deterministic",
    "filmmaking",
    "animation",
    "rendering"
  ],
  "author": "Samchon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samchon/automovie"
  },
  "devDependencies": {
    "@automovie/engine": "workspace:^",
    "@automovie/ingest": "workspace:^",
    "@automovie/interface": "workspace:^",
    "@automovie/recovery": "workspace:^",
    "@automovie/render": "workspace:^",
    "@automovie/viewer": "workspace:^",
    "@gltf-transform/core": "catalog:gltf",
    "@trivago/prettier-plugin-sort-imports": "catalog:typescript",
    "@ttsc/evidence": "catalog:samchon",
    "@ttsc/lint": "catalog:samchon",
    "@types/node": "catalog:utils",
    "@types/pngjs": "catalog:media",
    "@types/three": "catalog:three",
    "@wrtnlabs/evidence": "catalog:samchon",
    "bumpp": "catalog:utils",
    "h264-mp4-encoder": "catalog:media",
    "mp4box": "catalog:media",
    "playwright-core": "catalog:media",
    "pngjs": "catalog:media",
    "prettier": "catalog:typescript",
    "rimraf": "catalog:utils",
    "three": "catalog:three",
    "ttsc": "catalog:samchon",
    "typescript": "catalog:typescript",
    "typescript-compiler": "npm:typescript@5.9.3"
  }
}
